# /home/ubuntu/akari-pulse/.env  (chmod 600, never commit real values)
# Akari Health service (loopback only; 8787 is taken by another service on this box)
AKARI_HEALTH_HOST=127.0.0.1
AKARI_HEALTH_PORT=28787
AKARI_HEALTH_TOKEN=<generate>
AKARI_HEALTH_DB=/home/ubuntu/akari-pulse/data/akari-health.sqlite

# Drain client (relay -> local service)
AKARI_RELAY_URL=https://pulse.example.com
AKARI_RELAY_ADMIN_TOKEN=<ADMIN_TOKEN from relay/.secrets.local>
AKARI_HEALTH_URL=http://127.0.0.1:28787

# Remote MCP over Streamable HTTP (loopback; Cloudflare Tunnel exposes it)
AKARI_MCP_HTTP_HOST=127.0.0.1
AKARI_MCP_HTTP_PORT=28788
AKARI_MCP_HTTP_PATH=/mcp/<random url-safe token, 32+ chars>

# Cloudflare Tunnel connector token (remotely-managed tunnel your-tunnel-name)
AKARI_TUNNEL_TOKEN=<from Cloudflare API when the tunnel is created>
