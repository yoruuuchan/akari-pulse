[Unit]
Description=Akari Health MCP over Streamable HTTP (loopback; exposed via Cloudflare Tunnel)
After=akari-health.service
Wants=akari-health.service

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/akari-pulse/mcp
EnvironmentFile=/home/ubuntu/akari-pulse/.env
ExecStart=/opt/node24/bin/node src/http.js
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
