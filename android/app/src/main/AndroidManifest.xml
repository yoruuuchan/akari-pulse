<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="com.vivo.assistant.StepProvider" />

    <application
        android:name=".AkariPulseApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@drawable/ic_akari_pulse"
        android:label="akari pulse bridge"
        android:roundIcon="@drawable/ic_akari_pulse"
        android:supportsRtl="true"
        android:theme="@style/Theme.AkariPulse"
        android:usesCleartextTraffic="false">
        <meta-data
            android:name="vivo.health.rpc.appid"
            android:value="${vivoRpcAppId}" />
        <meta-data
            android:name="appid"
            android:value="${vivoRpcAppId}" />
        <meta-data
            android:name="health.device.manager.version"
            android:value="1" />

        <activity
            android:name=".ui.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".transport.http.WatchReceiverService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice"
            android:stopWithTask="false" />
    </application>
</manifest>
